# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Local (non-Docker) dev example: postgresql://postgres:postgres@localhost:5432/healthcare
# Docker Compose overrides this automatically to point at the `postgres` service.
DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/healthcare

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-value-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Base URL of the deployed frontend, used to build links embedded in
# password-reset and email-verification emails (e.g. https://app.example.com)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Used to build links embedded in password-reset/verification emails.
# Must match wherever the frontend is actually served.
FRONTEND_URL=http://localhost:5173

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Groq (LLM) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=20
GROQ_MAX_RETRIES=3
GROQ_TEMPERATURE=0.2

# --- RAG / ChromaDB ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./chroma_data
RAG_TOP_K=5

# --- Email ---
# EMAIL_PROVIDER options: console (default, prints to logs) | sendgrid | mailgun
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@clinic.example.com

# --- Google Calendar OAuth ---
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Enable the Google Calendar API for the project first.
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# --- Slot holds ---
SLOT_HOLD_DURATION_SECONDS=300

# --- Notifications ---
NOTIFICATION_MAX_ATTEMPTS=5

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
